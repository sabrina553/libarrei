# Copy to .env and fill in. Never commit .env.
# Hardcover: Settings -> API on hardcover.app
HARDCOVER_TOKEN=
# Goodreads: public AppSync key from the Goodreads web app's JS bundle
GOODREADS_TOKEN=
# Open Library: contact email sent in the User-Agent, as their API guidelines ask
OPENLIBRARY_CONTACT=
# Audible: store domain to search (com, co.uk, de, fr, it, es, ca, com.au, co.jp, in)
AUDIBLE_REGION=co.uk
# Amazon (optional, off when empty): the Cookie header from your signed-in browser
# session on Amazon, copied from DevTools -> Network. It is a credential: keep it here only.
# Scraping may breach Amazon's terms of use; enable at your own discretion.
AMAZON_COOKIE=
# Amazon store domain (com, co.uk, de, fr, ...)
AMAZON_DOMAIN=co.uk
