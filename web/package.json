{
  "name": "libarrei-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "types": "uv run --project .. libarrei openapi > openapi.json && pnpm dlx --package openapi-typescript@7.13.0 --package typescript@5.9 openapi-typescript openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "check": "tsc -b && oxlint && vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "diff": "9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
